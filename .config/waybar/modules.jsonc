{
  "hyprland/workspaces": {
    "format": "{id}",
    "all-outputs": false,
    "sort-by-number": true,
    "on-click": "activate",
    "persistent-workspaces": {
      "DP-1": [1, 2, 3, 4, 5],
      "DP-2": [6, 7, 8, 9, 10]
    }
  },
  "hyprland/window": {
    "format": "{title}",
    "max-length": 32,
    "separate-outputs": true,
    "icon": false,
    "tooltip": false
  },
  "clock": {
    "format": "{:%H:%M  ·  %a, %b %d}",
    "format-alt": "{:%A, %B %d · %Y}",
    "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>"
  },
  "mpris": {
    "format": "{player_icon} {title}",
    "format-paused": "",
    "format-stopped": "",
    "max-length": 24,
    "player-icons": { "default": "󰎈" },
    "tooltip-format": "{player}: {artist} — {title}\nClick: play/pause · Right-click: next"
  },
  "custom/weather": {
    "exec": "waybar-open-weather",
    "interval": 900,
    "return-type": "json",
    "format": "{}",
    "max-length": 22,
    "tooltip": false
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-bluetooth": "󰂯 {volume}%",
    "format-muted": "󰝟",
    "format-icons": {
      "headphone": "󰋋",
      "headset": "󰋎",
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "scroll-step": 2,
    "tooltip-format": "{desc}\nVolume: {volume}% · Click: audio settings\nRight-click: mute · Scroll: volume",
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },
  "network": {
    "format-wifi": "󰤨",
    "format-ethernet": "󰈀",
    "format-linked": "󰈀",
    "format-disconnected": "󰤭",
    "tooltip-format-wifi": "{essid} · {signalStrength}%\n{ifname} · {ipaddr}",
    "tooltip-format-ethernet": "Wired connection\n{ifname} · {ipaddr}",
    "tooltip-format-disconnected": "Network disconnected"
  },
  "group/system": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 200,
      "transition-left-to-right": false,
      "children-class": "system-detail"
    },
    "modules": ["custom/system", "cpu", "memory", "custom/pacman", "idle_inhibitor"]
  },
  "custom/system": {
    "format": "󰒓",
    "tooltip-format": "System details\nHover for CPU, memory, updates and idle control"
  },
  "cpu": {
    "format": "󰻠 {usage}%",
    "interval": 5,
    "tooltip-format": "CPU usage: {usage}%"
  },
  "memory": {
    "format": "󰍛 {}%",
    "interval": 5,
    "tooltip-format": "Memory: {used:0.1f} / {total:0.1f} GiB"
  },
  "custom/pacman": {
    // Read the existing package database; package synchronization stays manual.
    "exec": "pacman -Qu | wc -l",
    "interval": 1800,
    "format": "󰏗 {}",
    "tooltip-format": "Available updates from the last package database sync"
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": { "activated": "󰅶", "deactivated": "󰾪" },
    "tooltip-format-activated": "Stay awake enabled · Click to allow idle locking",
    "tooltip-format-deactivated": "Idle locking enabled · Click to stay awake"
  },
  "tray": { "icon-size": 16, "spacing": 10 },
  "custom/power": {
    "format": "󰐥",
    "tooltip-format": "Session and power controls",
    "on-click": "~/.local/bin/power-menu",
    "on-click-right": "~/.local/bin/lock-screen"
  }
}
