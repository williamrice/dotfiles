// Hyprland desktop bars for both monitors.
[
  {
    "name": "hyprland-ultragear",
    "output": "DP-1",
    "layer": "top",
    "height": 36,
    "spacing": 4,
    "modules-left": [
      "hyprland/workspaces",
      "custom/pacman",
      "hyprland/window",
    ],
    "modules-center": ["clock"],
    "modules-right": [
      "custom/weather",
      "mpd",
      "idle_inhibitor",
      "pulseaudio",
      "network",
      "cpu",
      "memory",
      "tray",
      "custom/power",
    ],
    "hyprland/workspaces": {
      "format": "{id}",
      "all-outputs": false,
      "sort-by-number": true,
      "on-click": "activate",
      "persistent-workspaces": {
        "DP-1": [1, 2, 3, 4, 5],
        "DP-2": [6, 7, 8, 9, 10],
      },
    },
    "hyprland/window": {
      "format": "{title}",
      "icon": false,
      "separate-outputs": true,
    },
    "idle_inhibitor": {
      "format": "{icon}",
      "format-icons": {
        "activated": "",
        "deactivated": "",
      },
      "tooltip-format-activated": "Idle inhibition active\nDisplays will stay on",
      "tooltip-format-deactivated": "Idle inhibition inactive\nDisplays turn off after 10 minutes",
    },
    "include": "/home/warice/.config/waybar/modules.jsonc",
  },
  {
    "name": "hyprland-dell",
    "output": "DP-2",
    "layer": "top",
    "height": 36,
    "spacing": 4,
    "modules-left": [
      "hyprland/workspaces",
      "custom/pacman",
      "hyprland/window",
    ],
    "modules-center": ["clock"],
    "modules-right": [
      "custom/weather",
      "mpd",
      "idle_inhibitor",
      "pulseaudio",
      "network",
      "cpu",
      "memory",
      "tray",
      "custom/power",
    ],
    "hyprland/workspaces": {
      "format": "{id}",
      "all-outputs": false,
      "sort-by-number": true,
      "on-click": "activate",
      "persistent-workspaces": {
        "DP-1": [1, 2, 3, 4, 5],
        "DP-2": [6, 7, 8, 9, 10],
      },
    },
    "hyprland/window": {
      "format": "{title}",
      "icon": false,
      "separate-outputs": true,
    },
    "idle_inhibitor": {
      "format": "{icon}",
      "format-icons": {
        "activated": "",
        "deactivated": "",
      },
      "tooltip-format-activated": "Idle inhibition active\nDisplays will stay on",
      "tooltip-format-deactivated": "Idle inhibition inactive\nDisplays turn off after 10 minutes",
    },
    "include": "/home/warice/.config/waybar/modules.jsonc",
  },
]
