{
  "name": "glass",
  "output": ["DP-1", "DP-2"],
  "layer": "top",
  "position": "top",
  "height": 42,
  "margin-top": 10,
  "margin-left": 12,
  "margin-right": 12,
  "margin-bottom": 0,
  "spacing": 0,
  "fixed-center": true,
  "reload_style_on_change": true,
  "modules-left": ["hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right": [
    "mpris",
    "custom/weather",
    "pulseaudio",
    "network",
    "group/system",
    "tray",
    "custom/power"
  ],
  "include": ["~/.config/waybar/modules.jsonc"]
}
