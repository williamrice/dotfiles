// Waybar configuration used only by MangoWM.
// The existing ~/.config/waybar configuration remains Hyprland-only.
[
  {
    "name": "mango-ultragear",
    "output": "DP-1",
    "layer": "top",
    "height": 36,
    "spacing": 4,
    "modules-left": [
      "mango/workspaces",
      "mango/layout",
      "custom/pacman",
      "mango/window",
    ],
    "modules-center": ["clock"],
    "modules-right": [
      "custom/weather",
      "mpd",
      "idle_inhibitor",
      "pulseaudio",
      "network",
      "cpu",
      "memory",
      "tray",
      "custom/power",
    ],
    "mango/workspaces": {
      "format": "{index}",
      "hide-empty": false,
      "on-click": "activate",
      "on-click-right": "toggle",
      "overview-label": "OVERVIEW",
    },
    "mango/layout": {
      "format": "󰕰 {}",
    },
    "mango/window": {
      "format": "{title}",
      "icon": false,
    },
    "idle_inhibitor": {
      "format": "{icon}",
      "format-icons": {
        "activated": "",
        "deactivated": "",
      },
      "tooltip-format-activated": "Idle inhibition active\nDisplays will stay on",
      "tooltip-format-deactivated": "Idle inhibition inactive\nDisplays turn off after 10 minutes",
    },
    "include": "/home/warice/.config/waybar/modules.jsonc",
  },
  {
    "name": "mango-dell",
    "output": "DP-2",
    "layer": "top",
    "height": 36,
    "spacing": 4,
    "modules-left": [
      "mango/workspaces",
      "mango/layout",
      "custom/pacman",
      "mango/window",
    ],
    "modules-center": ["clock"],
    "modules-right": [
      "custom/weather",
      "mpd",
      "idle_inhibitor",
      "pulseaudio",
      "network",
      "cpu",
      "memory",
      "tray",
      "custom/power",
    ],
    "mango/workspaces": {
      "format": "{index}",
      "hide-empty": false,
      "on-click": "activate",
      "on-click-right": "toggle",
      "overview-label": "OVERVIEW",
    },
    "mango/layout": {
      "format": "󰕰 {}",
    },
    "mango/window": {
      "format": "{title}",
      "icon": false,
    },
    "idle_inhibitor": {
      "format": "{icon}",
      "format-icons": {
        "activated": "",
        "deactivated": "",
      },
      "tooltip-format-activated": "Idle inhibition active\nDisplays will stay on",
      "tooltip-format-deactivated": "Idle inhibition inactive\nDisplays turn off after 10 minutes",
    },
    "include": "/home/warice/.config/waybar/modules.jsonc",
  },
]
