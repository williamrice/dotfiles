#!/usr/bin/env bash
set -euo pipefail
# Swaylock -f returns only after the session is locked.
# Serializing launch prevents two simultaneous idle/suspend/shortcut requests.
exec 9>"${XDG_RUNTIME_DIR:?}/swaylock-launch.lock"
flock 9
if ! pgrep -u "$(id -u)" -x swaylock >/dev/null; then
    /usr/bin/swaylock --config /home/warice/.config/swaylock/config --daemonize 9>&-
fi
if [[ ${1:-} == --screen-off ]]; then
    /usr/bin/wlr-dpms off
fi
