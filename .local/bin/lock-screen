#!/usr/bin/env bash
set -euo pipefail

# Hold the launch lock for the lifetime of the locker to serialize all callers.
exec 9>"${XDG_RUNTIME_DIR:?}/hyprlock-launch.lock"
flock -n 9 || exit 0
if pgrep -u "$(id -u)" -x hyprlock >/dev/null; then
    exit 0
fi
exec /usr/bin/hyprlock --config "$HOME/.config/hypr/hyprlock.conf" --no-fade-in --grace 0
